
<% @students_by_classrooms.each do |classroom| %>
  <% classroom_id, classroom_info = classroom %>
  <table>
    <thead>
      <%# Série e Turma numa única célula: o motor não quebra página dentro de
          uma linha de tabela, então as duas faixas nunca se separam. %>
      <tr>
        <th scope="col" style='text-align: center' colspan='3'>
          <div><%= "Série: #{classroom_info[:grade_name]}" %></div>
          <div class="classroom-name"><%= "Turma: #{classroom_info[:classroom_name]}" %></div>
        </th>
      </tr>
    </thead>
    <thead>
      <tr>
        <td style='width: 1%'><b>Nº</b></td>
        <td><b>Nome do aluno</b></td>
        <td><b>Frequência</b></td>
      </tr>
    </thead>
    <tbody>
      <% sequence = 0 %>
      <% classroom_info[:students].each do |student| %></td>
        <tr>
          <% if student[:sequence] %>
            <td><%= student[:sequence] %></td>
          <% else %>
            <% sequence += 1 %>
            <td><%= sequence %></td>
          <% end %>
          <td><%= student[:student_name] %></td>
          <td>
            <% if student[:frequency].nil? %>
              0%
            <% else %>
              <%= "#{student[:frequency][:percentage_frequency]}%" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
