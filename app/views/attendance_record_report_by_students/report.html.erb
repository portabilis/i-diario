<style>
  table {
    border-collapse: collapse;
    width: 95%;
    margin: 2%;
  }

  th,
  td {
    border: 1px solid #000000;
    text-align: left;
    padding: 8px;
  }

  /* Mesmo cinza da faixa do título e da seção Identificação. */
