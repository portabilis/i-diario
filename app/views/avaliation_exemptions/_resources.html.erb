<tbody id="resources-tbody">
  <% if @avaliation_exemptions.empty? %>
    <tr>
      <td class="no_record_found" colspan="7"> <%= t('views.index.no_record_found')%></td>
    </tr>
  <% else %>
    <% @avaliation_exemptions.map { |avaliation_exemption| avaliation_exemption.localized }.each do |avaliation_exemption| %>
      <tr>
        <td><%= avaliation_exemption.avaliation.unity %></td>
        <td><%= avaliation_exemption.avaliation.classroom %></td>
        <td><span class="multiline"><%= avaliation_exemption.student %></span/></td>
        <td><%= avaliation_exemption.avaliation.discipline %></td>
        <td><%= avaliation_exemption.avaliation %></td>
        <td><%= avaliation_exemption.created_at %></td>
        <td class="actions">
          <%= link_to t('views.index.edit'), edit_avaliation_exemption_path(avaliation_exemption),
                      class: "btn btn-success pull-left" %>
          <%= link_to t('views.index.delete'), avaliation_exemption_path(avaliation_exemption),
                      class: "btn btn-danger pull-right", method: "delete",
                      data: { confirm: t('views.index.confirm_deletion') } %>
        </td>
      </tr>
    <% end %>
  <% end %>
</tbody>
