<% content_for :js do %>
  <%= javascript_include_tag 'views/conceptual_exams/index' %>
<% end %>

<div class='widget-body no-padding'>
  <%= simple_form_for @filter, as: :filter, url: conceptual_exams_path, method: :get,
    html: { class: 'filterable_search_form' } do |f| %>
    <div class='table-responsive'>
      <table id='resources' class='table table-bordered table-only-inner-bordered table-striped table-condensed table-hover'>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">
              <%= f.input :by_classroom_id, as: :select2, elements: @classrooms,
                            label: false, placeholder: t('.by_classroom_id'),
                            input_html: { value: current_user_classroom.id } %>
            </th>
            <th scope="col">
              <%= f.input :by_student_id, as: :select2, elements: [],
                            label: false, placeholder: t('.by_student_name'),
                            input_html: { class: 'conceptual-exam-student-filter' } %>
            </th>
            <th scope="col">
              <%= f.input :by_step_id, as: :select2, elements: @steps,
                label: false, placeholder: t('.by_step_id') %></th>
            <th scope="col">
              <%= f.input :by_status, as: :select2, elements: ConceptualExamStatus.to_select.to_json,
                label: false, placeholder: t('.by_status') %>
            </th>
            <th scope="col">
              <%= link_to t('.new_html'), new_conceptual_exam_path, class: 'btn btn-primary pull-right' %>
            </th>
          </tr>

          <tr>
            <th scope="col"><%= ConceptualExam.human_attribute_name :unity_id %></th>
            <th scope="col"><%= ConceptualExam.human_attribute_name :classroom %></th>
            <th scope="col"><%= ConceptualExam.human_attribute_name :student %></th>
            <th scope="col"><%= ConceptualExam.human_attribute_name :step %></th>
            <th scope="col"><%= ConceptualExam.human_attribute_name :status %></th>
            <th scope="col" style="width: 160px"></th>
          </tr>
        </thead>

        <%= render 'resources' %>

        <tfoot id="paginator" class="remote">
          <td id="pagination-tfoot" colspan="8">
            <%= render 'shared/pagination', records: @conceptual_exams %>
          </td>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
