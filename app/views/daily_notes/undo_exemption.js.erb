var student_id = <%= @student_id %>;

if (student_id) {
  $('#exempt_student_check_' + student_id).removeAttr('disabled');

  var $row = $('#tr_student_' + student_id);
  var $badges = $('#student_status_badges_' + student_id);

  $badges.find('.badge-status--exempted').remove();

  var noteInput = $row.find("input[id ^='daily_note_students_attributes'][id $='note']")[0];
  $(noteInput).removeClass('exempted-student');

  var undo_exemption_button = $('#do_undo_exemption_' + student_id);
  undo_exemption_button.removeClass('undo-exemption');
  undo_exemption_button.removeClass('btn-default');
  undo_exemption_button.addClass('do-exemption');
  undo_exemption_button.addClass('open-exemption-modal');
  undo_exemption_button.addClass('btn-primary');
  undo_exemption_button.removeAttr('data-remote');
  undo_exemption_button.removeAttr('data-method');
  undo_exemption_button.attr('href', '#');
  undo_exemption_button.attr('title', 'Dispensar');

  if (!$row.data('in-active-search')) {
    $(noteInput).removeAttr('readonly');
    $(noteInput).removeAttr('placeholder');
  }
}
