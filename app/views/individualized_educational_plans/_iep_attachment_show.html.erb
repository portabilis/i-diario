<tr class="nested-fields">
  <td>
    <% if f.object.filename.present? %>
      <%= link_to f.object.filename, f.object.attachment.url, target: '_blank' %>
    <% else %>
      <span class="text-muted"><%= t('.file_unavailable') %></span>
    <% end %>
  </td>
  <td class="text-center" style="width: 60px;">
    <%= link_to_remove_association content_tag(:i, '', class: 'fa fa-trash'), f, class: 'btn btn-danger btn-sm' %>
  </td>
</tr>
