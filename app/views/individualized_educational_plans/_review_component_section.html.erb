<%# Estrutura das seções 4/5: botões de revisão > abas Por Disciplina/Por Campo >
    componentes adicionados sob demanda (modal).
    Locals: f, review_dates, association (:iep_curricular_plannings/:iep_periodic_evaluations),
            fields_partial, dom_prefix ("s4"/"s5"), view_only (opcional) %>
<% view_only = local_assigns[:view_only] %>
<% if review_dates.empty? %>
  <div class="alert alert-info fade in">
    <i class="fa-fw fa fa-info"></i>
    <%= t('individualized_educational_plans.form.no_reviews_hint') %>
    <%# O atalho só aparece para quem edita a seção 1: o professor (escopo de componente) não a altera. %>
    <% if !view_only && @editable_component_scope.blank? %>
      <button type="button" class="btn btn-default btn-xs iep-go-to-identification">
        <%= t('individualized_educational_plans.form.go_to_identification') %>
      </button>
    <% end %>
  </div>
<% else %>
  <div class="btn-group iep-review-buttons" style="margin-bottom: 15px;">
    <% review_dates.each_with_index do |review_date, index| %>
      <button type="button" class="btn <%= index.zero? ? 'btn-primary active' : 'btn-default' %>"
              data-review-id="<%= review_date.id %>">
        <%= t('individualized_educational_plans.form.review_label', number: index + 1) %>
        (<%= l(review_date.review_date) %>)
      </button>
    <% end %>
  </div>

  <% review_dates.each_with_index do |review_date, review_index| %>
    <div class="iep-review-panel" data-review-id="<%= review_date.id %>"
         <%= 'style="display:none;"'.html_safe unless review_index.zero? %>>
      <ul class="nav nav-tabs">
        <li class="active">
          <a href="#<%= dom_prefix %>-r<%= review_date.id %>-disciplines" data-toggle="tab">
            <%= t('individualized_educational_plans.form.by_discipline') %>
          </a>
        </li>
        <li>
          <a href="#<%= dom_prefix %>-r<%= review_date.id %>-knowledge-areas" data-toggle="tab">
            <%= t('individualized_educational_plans.form.by_knowledge_area') %>
          </a>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane active" id="<%= dom_prefix %>-r<%= review_date.id %>-disciplines">
          <%= render 'component_type_panel', f: f, association: association, fields_partial: fields_partial,
                review_date: review_date, component_type: :discipline, view_only: view_only,
                dom_id: "#{dom_prefix}-r#{review_date.id}-d" %>
        </div>

        <div class="tab-pane" id="<%= dom_prefix %>-r<%= review_date.id %>-knowledge-areas">
          <%= render 'component_type_panel', f: f, association: association, fields_partial: fields_partial,
                review_date: review_date, component_type: :knowledge_area, view_only: view_only,
                dom_id: "#{dom_prefix}-r#{review_date.id}-k" %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
