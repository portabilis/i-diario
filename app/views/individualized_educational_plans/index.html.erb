<% content_for :js do %>
  <%= javascript_include_tag 'views/individualized_educational_plans/index' %>
<% end %>

<div class="widget-body no-padding">
  <%= simple_form_for :filter, { url: individualized_educational_plans_path, method: :get, html: { class: 'filterable_search_form' } } do |f| %>
    <div class="table-responsive">
      <table id="resources" class="table table-bordered table-only-inner-bordered table-striped table-condensed table-hover">
        <thead>
          <tr>
            <th scope="col" colspan="2">
              <%= f.input :by_classroom_id, as: :select2, elements: @classrooms,
                          label: false, placeholder: t('.filter_by_classroom'),
                          input_html: { value: current_user_classroom.id } %>
            </th>
            <th scope="col" colspan="3">
              <%= f.input :by_student_id, as: :select2, elements: [],
                          label: false, placeholder: t('.filter_by_student'),
                          input_html: { class: 'iep-student-filter' } %>
            </th>
            <th scope="col">
              <%= link_to t('.new_html'), new_individualized_educational_plan_path,
                          class: 'btn btn-primary pull-right', style: 'width: 100%;' %>
            </th>
          </tr>

          <tr>
            <th scope="col"><%= IndividualizedEducationalPlan.human_attribute_name :year %></th>
            <th scope="col"><%= IndividualizedEducationalPlan.human_attribute_name :unity %></th>
            <th scope="col"><%= IndividualizedEducationalPlan.human_attribute_name :classroom %></th>
            <th scope="col"><%= IndividualizedEducationalPlan.human_attribute_name :student %></th>
            <th scope="col"><%= t('.last_edit') %></th>
            <th scope="col" style="width: 200px"></th>
          </tr>
        </thead>

        <%= render 'resources' %>

        <tfoot id="paginator" class="remote">
          <td id="pagination-tfoot" colspan="6">
            <%= render 'shared/pagination', records: @individualized_educational_plans %>
          </td>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
