<table>
  <thead>
    <tr>
      <th colspan="2" class="section-title"><%= t('.title') %></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="text-align: center; width: 50px; height: 50px;">
        <%= image_tag(current_entity_configuration.logo.url, size: '50x50') if current_entity_configuration&.logo %>
      </td>
      <td style="text-align: center;">
        <br><%= current_entity_configuration&.entity_name %>
        <br><%= current_entity_configuration&.organ_name %>
        <% if @version.present? %>
          <br><%= t('.version_info', name: @version.name,
                                     date: l(@version.published_at, format: :short),
                                     author: @version.published_by.name) %>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<%= render 'individualized_educational_plans/pdf_content', presenter: @presenter %>
