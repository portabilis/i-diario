<div class="widget-body no-padding">
  <div class="table-responsive">
    <table id="resources" class="table table-bordered table-only-inner-bordered table-striped table-condensed table-hover">
      <thead>
        <tr>
          <th scope="col"><%= t('.student') %>: <strong><%= @individualized_educational_plan.student %></strong></th>
          <th scope="col" colspan="4">
            <%= link_to t('.back'), individualized_educational_plans_path, class: 'btn btn-default pull-right' %>
          </th>
        </tr>
        <tr>
          <th scope="col"><%= t('.name') %></th>
          <th scope="col"><%= t('.published_at') %></th>
          <th scope="col"><%= t('.published_by') %></th>
          <th scope="col" style="width: 120px"><%= t('.status') %></th>
          <th scope="col" style="width: 160px"></th>
        </tr>
      </thead>

      <tbody id="resources-tbody">
        <% if @versions.empty? %>
          <tr>
            <td class="no_record_found" colspan="5"><%= t('views.index.no_record_found') %></td>
          </tr>
        <% else %>
          <% @versions.each do |version| %>
            <tr>
              <td><%= version.name %></td>
              <td><%= l(version.published_at, format: :short) %></td>
              <td><%= version.published_by.name %></td>
              <td>
                <% if version.active? %>
                  <span class="label label-success"><%= t('.active') %></span>
                <% end %>
              </td>
              <td class="actions">
                <%= link_to t('helpers.links.show_html'),
                      individualized_educational_plan_version_path(@individualized_educational_plan, version),
                      class: 'btn btn-info apply_tooltip',
                      data: { original_title: t('.show_tooltip') } %>
                <%= link_to t('helpers.links.print_html'),
                      individualized_educational_plan_version_path(@individualized_educational_plan, version, format: :pdf),
                      class: 'btn btn-info apply_tooltip', target: '_blank',
                      data: { original_title: t('.print_tooltip') } %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
