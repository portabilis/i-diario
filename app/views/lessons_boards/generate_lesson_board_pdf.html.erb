<%# O título, o brasão e a identificação da rede vêm do cabeçalho do report_pluto. %>
<% content_for :report_title, 'Quadro de Aulas' %>

<% content_for :head do %>
  <style>
    /* As tabelas ocupam a largura útil inteira, com folga só na vertical entre
       as seções: cada célula de aula guarda nome de professor e disciplina, e
       coluna estreita multiplica as linhas de cada aula. */
    table {
      width: 100%;
      margin: 0 0 4mm;
    }

    /* 11.2px é o tamanho impresso no motor anterior, medido no PDF: o layout
       antigo declarava 12px, mas a página excedia a área imprimível e o chrome
       a reduzia por inteiro (fator 0,935). */
    th,
    td {
      padding: 8px;
      font-size: 11.2px;
    }

    /* Fundo das linhas de cabeçalho das duas tabelas. O report_pluto deixa th
       sem cor de fundo, e este relatório distingue cabeçalho de conteúdo por
       ele. */
    .info-table .info-header th,
    .lessons-table th {
      background-color: #DEDEDE;
      text-align: center;
    }

    /* A linha de identificação sai em negrito, destacada do corpo da tabela. */
    .info-table td {
      font-weight: bold;
    }

    .lessons-table td {
      text-align: center;
    }

    /* A coluna do número da aula guarda só um dígito; o que sobra dela vai
       para as colunas dos dias da semana. */
    .lessons-table th:first-child,
    .lessons-table td:first-child {
      width: 10%;
    }
  </style>
<% end %>

<table class="info-table">
  <thead>
    <tr class="info-header">
      <th><strong><%= t('lessons_boards.index.unity') %></strong></th>
      <th><strong><%= t('lessons_boards.index.grade') %></strong></th>
      <th><strong><%= t('lessons_boards.index.classroom') %></strong></th>
      <th><strong><%= t('lessons_boards.form.period') %></strong></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @lesson_board.classrooms_grade.classroom.unity.name %></td>
      <td><%= @lesson_board.classrooms_grade.grade.description %></td>
      <td><%= @lesson_board.classrooms_grade.classroom.description %></td>
      <td><%= Periods.translate(Periods.key_for(@lesson_board.period.to_s)) %></td>
    </tr>
  </tbody>
</table>

<table class="lessons-table">
  <thead>
    <tr>
      <th style="width: 10%;">Nº Aula</th>
      <% Workdays.translations.each do |weekday| %>
        <th><%= weekday %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @lesson_board.lessons_board_lessons.each do |lesson| %>
      <tr>
        <td><%= lesson.lesson_number %></td>
        <% Workdays.list.each do |weekday| %>
          <td>
            <% lesson_weekday = lesson.lessons_board_lesson_weekdays.find { |lwl| lwl.weekday == weekday } %>
            <% if lesson_weekday&.teacher_discipline_classroom.present? %>
              <%= lesson_weekday.teacher_discipline_classroom.teacher.name %> -
              <%= lesson_weekday.teacher_discipline_classroom.discipline.description %>
            <% else %>
              -
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
