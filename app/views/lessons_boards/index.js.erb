$('#resources-tbody').replaceWith('<%= escape_javascript(render("resources")) %>');
$('#pagination-tfoot').html(
  "<%=
    escape_javascript(render(partial: 'shared/pagination', locals: { records: @lessons_boards }))
  %>"
);

<%# Cascata: o servidor devolve as opções válidas e o valor saneado de cada filtro %>
lessonsBoardsIndex.refreshFilter('search_by_unity',
  <%= raw select2_elements_json(@unities_options) %>, '<%= escape_javascript(@filtering_params[:by_unity].to_s) %>');
lessonsBoardsIndex.refreshFilter('search_by_grade',
  <%= raw select2_elements_json(@grades_options) %>, '<%= escape_javascript(@filtering_params[:by_grade].to_s) %>');
lessonsBoardsIndex.refreshFilter('search_by_classroom',
  <%= raw select2_elements_json(@classrooms_options) %>, '<%= escape_javascript(@filtering_params[:by_classroom].to_s) %>');
